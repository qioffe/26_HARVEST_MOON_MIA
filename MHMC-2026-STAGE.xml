        </performance>

        <performance number="13" genre="Ensemble Vocal &amp; Dance">
          <title>
            <en>A Night of Flowers and a Full Moon</en>
            <zh-Hans>《花好月圆夜》</zh-Hans>
          </title>
          <ensemble>
            <name>
              <en>St. Brendan High School</en>
              <zh-Hans>圣布伦丹高中</zh-Hans>
            </name>
          </ensemble>
        </performance>

        <performance number="14" genre="East-West Musical Fusion">
          <title>
            <en>"Moonlight in the City" × "Vivir Mi Vida" (Chinese Ruan and Cuban Music Fusion)</en>
            <zh-Hans>《城里的月光 × Vivir Mi Vida》阮与古巴音乐跨界合奏</zh-Hans>
          </title>
          <ensemble>
            <name>
              <en>Fang Music &amp; Joel Indira Band</en>
              <zh-Hans>方乐团与乔尔·因迪拉乐队</zh-Hans>
            </name>
          </ensemble>
        </performance>
      </performances>
    </chapter>

    <!-- Grand Finale -->
    <chapter id="grand-finale" sequence="5">
      <chapterTitle>
        <en>Grand Finale: Culture in Motion, Friendship Beyond Borders</en>
        <zh-Hans>终章：文化共舞，友谊无界</zh-Hans>
      </chapterTitle>
      <performances>
        <performance number="15" genre="Cultural Fashion Runway">
          <title>
            <en>Asian Cultural Attire Fashion Walk</en>
