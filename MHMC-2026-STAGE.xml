          <artists>
            <artist role="Vocalist">
              <name>
                <en>Anaiyah Sunshine</en>
                <zh-Hans>Anaiyah Sunshine</zh-Hans>
              </name>
              <title>
                <en>Ms. Florida America's United States</en>
                <zh-Hans>佛罗里达美利坚合众国小姐</zh-Hans>
              </title>
